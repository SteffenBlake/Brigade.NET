<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/.generated</CompilerGeneratedFilesOutputPath>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".generated/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Brigade.Net.Example.Domain.csproj" />
    <ProjectReference Include="..\ServiceDefaults\Brigade.Net.Example.ServiceDefaults.csproj" />

    <ProjectReference Include="..\..\Source\Partie.AspNetCore\Brigade.Net.Partie.AspNetCore.csproj" />
    <ProjectReference Include="..\..\Source\Partie.Extensions.Mise\Brigade.Net.Partie.Extensions.Mise.csproj" />
    <ProjectReference Include="..\..\Source\Partie.Extensions.Expo\Brigade.Net.Partie.Extensions.Expo.csproj" />
    <ProjectReference Include="..\..\Source\Partie.Extensions.Expo.Engines.AspNetCore\Brigade.Net.Partie.Extensions.Expo.Engines.AspNetCore.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Source\Partie.Engines.AspNetCore\Brigade.Net.Partie.Engines.AspNetCore.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
