<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratorSupportAssembly>Brigade.Net.Mise.Generator.dll</GeneratorSupportAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <ProjectReference Include="../Mise.Generator/Brigade.Net.Mise.Generator.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="IncludeGeneratorCore" AfterTargets="GetTargetPathWithTargetPlatformMoniker">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)Brigade.Net.Mise.Generator.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
